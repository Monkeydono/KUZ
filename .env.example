# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=KUZ
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=

# Admin emails (comma-separated) — bypass quota and 7-day limit
ADMIN_EMAILS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# KU ALL-Login (Keycloak OIDC ของ OCS) — ขอ client จาก สำนักบริการคอมพิวเตอร์
# ถ้าเว้นว่าง ปุ่ม KU ALL-Login จะแจ้ง "ยังไม่เปิดใช้งาน" แทนที่จะพัง
# client_id/realm ต้องตรงกับที่ OCS ลงทะเบียน ไม่งั้น Keycloak ตอบ "Client not found"
KU_LOGIN_CLIENT_ID=
KU_LOGIN_CLIENT_SECRET=
# ต้องตรงเป๊ะกับ redirect_uri ที่ลงทะเบียนไว้กับ OCS (prod = https://meet.ocs.ku.ac.th/calendar)
KU_LOGIN_REDIRECT_URI=http://localhost:5173/calendar
KU_LOGIN_SCOPE=basic openid
# ตั้งเมื่อ OCS ให้ client อยู่คนละ host/realm (เช่น realm ทดสอบ) — ปกติไม่ต้องใส่
KU_LOGIN_BASE_URL=https://alllogin.ku.ac.th
KU_LOGIN_REALM=KU-Alllogin

# Zoom (Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Webhook secret token จาก Zoom marketplace app → Feature → Event Subscriptions
# ใช้ verify HMAC signature ของ event ที่ Zoom ส่งมา (REQUIRED ใน production)
ZOOM_WEBHOOK_SECRET_TOKEN=

# n8n webhooks (URL แยกของ workflow แต่ละ event)
N8N_NOTIFICATION_WEBHOOK_URL=
N8N_CANCELLATION_WEBHOOK_URL=
N8N_REMINDER_WEBHOOK_URL=
N8N_COHOST_INVITE_WEBHOOK_URL=
# แจ้ง staff/admin เมื่อมีคำขอจองห้อง Pro plan (capacity > 100) รออนุมัติ
N8N_PENDING_APPROVAL_WEBHOOK_URL=
# แจ้ง user เมื่อ booking ถูก approve/reject (workflow เดียวกัน branch ตาม field "decision")
N8N_APPROVAL_DECISION_WEBHOOK_URL=
